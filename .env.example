# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` - it contains secrets.

# --- Supabase (OPTIONAL - only needed for scripts/seed.mjs) ---
# The app itself runs entirely on localStorage and needs NO environment
# variables. These are only required if you want to (re-)seed a Supabase
# project using scripts/seed.mjs.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key - used ONLY by scripts/seed.mjs.
# Never prefix with VITE_ and never expose in the frontend.
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
