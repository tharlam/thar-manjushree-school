# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` - it contains secrets.

# --- Supabase (required for the app) ---
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY power Supabase Auth and all
# data queries in the frontend. Without them the admin login screen will
# report that Supabase is not configured.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key - used ONLY by scripts/seed.mjs.
# Never prefix with VITE_ and never expose in the frontend.
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
