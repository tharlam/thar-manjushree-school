# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` - it contains secrets.

# --- Supabase (Project Settings -> API) ---
# Public anon key - safe to expose in the browser bundle (RLS protects data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key - used ONLY by scripts/seed.mjs and any server-side code.
# Never prefix with VITE_ and never expose in the frontend.
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Seed script (optional, one-time) ---
# Creates the first admin login via Supabase Auth.
SEED_ADMIN_EMAIL=admin@thar-manjushree.edu.np
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_ADMIN_NAME=School Administrator

# --- Payment gateways ---
# Khalti (Nepal) - https://developer.khalti.com
# Public key - safe to expose in the browser bundle.
VITE_KHALTI_PUBLIC_KEY=your-khalti-public-key
# Secret key - used ONLY by the Supabase Edge Function "verify-donation".
# Do NOT prefix with VITE_. Set it with:
#   supabase secrets set KHALTI_SECRET_KEY=<secret>
# (Do NOT put it in .env / .env.example)
# VITE_ESEWA_MERCHANT_ID=
# VITE_ESEWA_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
